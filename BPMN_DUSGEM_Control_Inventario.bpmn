<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
 id="Definitions_DUSGEM" targetNamespace="http://dusgem.example/bpmn">
 <bpmn:process id="Proceso_Control_Inventario_DUSGEM" name="Gestión, control y abastecimiento de materiales - DUSGEM" isExecutable="true">
  <bpmn:documentation>Proceso académico propuesto para solicitar, validar, consultar, entregar y reabastecer materiales de ensamblaje. Las tareas de sistema representan operaciones previstas en la API REST y PostgreSQL.</bpmn:documentation>
  <bpmn:laneSet id="LaneSet_DUSGEM">
   <bpmn:lane id="Lane_montaje" name="Personal de montaje">
    <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>solicitar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>entregar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>confirmar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_almacen" name="Encargado de almacén">
    <bpmn:flowNodeRef>recibir</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>validar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>g_valida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>corregir</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>ubicar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>preparar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>verificar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>g_preparado</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>notificar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>recibir_compra</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>g_cantidad</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>reportar_dif</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>cerrar</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_supervisor" name="Supervisor">
    <bpmn:flowNodeRef>g_autoriza</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>sol_compra</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_sistema" name="Sistema de inventario (API REST / PostgreSQL)">
    <bpmn:flowNodeRef>consultar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>registrar_salida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>actualizar_salida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>pendiente</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>registrar_entrada</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>actualizar_entrada</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>reconsultar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>historial</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>end_pending</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="start" name="Inicio: necesidad de materiales"/>
  <bpmn:task id="solicitar" name="Generar solicitud de materiales"/>
  <bpmn:task id="recibir" name="Recibir solicitud"/>
  <bpmn:task id="validar" name="Validar datos de la solicitud"/>
  <bpmn:exclusiveGateway id="g_valida" name="¿Solicitud válida?" gatewayDirection="Diverging"/>
  <bpmn:task id="corregir" name="Solicitar corrección de datos"/>
  <bpmn:task id="consultar" name="Consultar existencias en PostgreSQL mediante API"/>
  <bpmn:exclusiveGateway id="g_stock" name="¿Hay cantidad suficiente?" gatewayDirection="Diverging"/>
  <bpmn:task id="ubicar" name="Localizar materiales en almacén"/>
  <bpmn:task id="preparar" name="Preparar materiales solicitados"/>
  <bpmn:task id="verificar" name="Verificar cantidades y estado"/>
  <bpmn:exclusiveGateway id="g_preparado" name="¿Preparación correcta?" gatewayDirection="Diverging"/>
  <bpmn:task id="registrar_salida" name="Registrar salida de materiales"/>
  <bpmn:task id="actualizar_salida" name="Actualizar existencias e historial"/>
  <bpmn:task id="entregar" name="Entregar materiales al personal"/>
  <bpmn:task id="confirmar" name="Confirmar recepción de materiales"/>
  <bpmn:exclusiveGateway id="g_autoriza" name="¿Supervisor autoriza reposición?" gatewayDirection="Diverging"/>
  <bpmn:task id="notificar" name="Notificar faltante al supervisor"/>
  <bpmn:task id="sol_compra" name="Solicitar compra o reabastecimiento"/>
  <bpmn:task id="pendiente" name="Registrar solicitud pendiente y notificar"/>
  <bpmn:task id="recibir_compra" name="Recibir materiales de reposición"/>
  <bpmn:exclusiveGateway id="g_cantidad" name="¿Cantidad recibida correcta?" gatewayDirection="Diverging"/>
  <bpmn:task id="reportar_dif" name="Reportar diferencia al proveedor"/>
  <bpmn:task id="registrar_entrada" name="Registrar entrada de materiales"/>
  <bpmn:task id="actualizar_entrada" name="Actualizar existencias e historial"/>
  <bpmn:task id="reconsultar" name="Volver a consultar inventario"/>
  <bpmn:task id="historial" name="Consolidar movimiento y estado de solicitud"/>
  <bpmn:task id="cerrar" name="Cerrar solicitud"/>
  <bpmn:endEvent id="end_ok" name="Fin: solicitud atendida"/>
  <bpmn:endEvent id="end_pending" name="Fin: solicitud pendiente"/>
  <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="solicitar"/>
  <bpmn:sequenceFlow id="f2" sourceRef="solicitar" targetRef="recibir"/>
  <bpmn:sequenceFlow id="f3" sourceRef="recibir" targetRef="validar"/>
  <bpmn:sequenceFlow id="f4" sourceRef="validar" targetRef="g_valida"/>
  <bpmn:sequenceFlow id="f5" sourceRef="g_valida" targetRef="consultar"/>
  <bpmn:sequenceFlow id="f6" sourceRef="g_valida" targetRef="corregir"/>
  <bpmn:sequenceFlow id="f7" sourceRef="corregir" targetRef="validar"/>
  <bpmn:sequenceFlow id="f8" sourceRef="consultar" targetRef="g_stock"/>
  <bpmn:sequenceFlow id="f9" sourceRef="g_stock" targetRef="ubicar"/>
  <bpmn:sequenceFlow id="f10" sourceRef="g_stock" targetRef="notificar"/>
  <bpmn:sequenceFlow id="f11" sourceRef="ubicar" targetRef="preparar"/>
  <bpmn:sequenceFlow id="f12" sourceRef="preparar" targetRef="verificar"/>
  <bpmn:sequenceFlow id="f13" sourceRef="verificar" targetRef="g_preparado"/>
  <bpmn:sequenceFlow id="f14" sourceRef="g_preparado" targetRef="registrar_salida"/>
  <bpmn:sequenceFlow id="f15" sourceRef="g_preparado" targetRef="preparar"/>
  <bpmn:sequenceFlow id="f16" sourceRef="registrar_salida" targetRef="actualizar_salida"/>
  <bpmn:sequenceFlow id="f17" sourceRef="actualizar_salida" targetRef="entregar"/>
  <bpmn:sequenceFlow id="f18" sourceRef="entregar" targetRef="confirmar"/>
  <bpmn:sequenceFlow id="f19" sourceRef="confirmar" targetRef="historial"/>
  <bpmn:sequenceFlow id="f20" sourceRef="notificar" targetRef="g_autoriza"/>
  <bpmn:sequenceFlow id="f21" sourceRef="g_autoriza" targetRef="sol_compra"/>
  <bpmn:sequenceFlow id="f22" sourceRef="g_autoriza" targetRef="pendiente"/>
  <bpmn:sequenceFlow id="f23" sourceRef="pendiente" targetRef="end_pending"/>
  <bpmn:sequenceFlow id="f24" sourceRef="sol_compra" targetRef="recibir_compra"/>
  <bpmn:sequenceFlow id="f25" sourceRef="recibir_compra" targetRef="g_cantidad"/>
  <bpmn:sequenceFlow id="f26" sourceRef="g_cantidad" targetRef="registrar_entrada"/>
  <bpmn:sequenceFlow id="f27" sourceRef="g_cantidad" targetRef="reportar_dif"/>
  <bpmn:sequenceFlow id="f28" sourceRef="reportar_dif" targetRef="recibir_compra"/>
  <bpmn:sequenceFlow id="f29" sourceRef="registrar_entrada" targetRef="actualizar_entrada"/>
  <bpmn:sequenceFlow id="f30" sourceRef="actualizar_entrada" targetRef="reconsultar"/>
  <bpmn:sequenceFlow id="f31" sourceRef="reconsultar" targetRef="consultar"/>
  <bpmn:sequenceFlow id="f32" sourceRef="historial" targetRef="cerrar"/>
  <bpmn:sequenceFlow id="f33" sourceRef="cerrar" targetRef="end_ok"/>
 </bpmn:process>
